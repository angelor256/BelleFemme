<!DOCTYPE html>
<html lang="es-CR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Belle Femme · Reservar cita</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300..700;1,300..600&family=Jost:wght@300;400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet">
<style>
  :root{
    --accent:#A8586E;      /* rosa Belle Femme */
    --ink:#241C1F;
    --paper:#FBF3F1;
    --card:#fff;
    --line:#EFE1E1;
    --line-2:#EBD9DB;
    --muted:#9A8C8E;
    --muted-2:#A08E90;
    --disabled-bg:#F3EAEA;
    --disabled-fg:#C0B2B4;
    --serif:'Cormorant Garamond',Georgia,serif;
    --sans:'Jost',system-ui,-apple-system,sans-serif;
    --script:'Pinyon Script',cursive;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{background:var(--paper);font-family:var(--sans);color:var(--ink);-webkit-font-smoothing:antialiased}
  .app{max-width:430px;min-height:100%;margin:0 auto;background:var(--paper);display:flex;flex-direction:column;position:relative}
  .eyebrow{font:400 9px/1 var(--sans);letter-spacing:.28em;text-transform:uppercase;color:var(--muted-2)}
  .h1{font-family:var(--serif);font-weight:300;font-size:27px;line-height:1.2}
  .hint{font:300 11.5px/1.6 var(--sans);color:var(--muted)}
  .price{font:400 13px var(--sans)}
  .name{font-family:var(--serif);font-size:19px;line-height:1.25}

  /* ── Cabecera de pasos ─────────────────────────────── */
  header{position:sticky;top:0;z-index:5;background:var(--paper);border-bottom:1px solid var(--line);padding:calc(14px + env(safe-area-inset-top)) 22px 14px}
  .hrow{display:flex;align-items:center;justify-content:space-between}
  .back{width:34px;height:34px;display:flex;align-items:center;justify-content:center;font-size:17px;background:none;border:0;color:var(--ink);cursor:pointer}
  .bar{margin-top:14px;height:1px;background:var(--line-2);position:relative}
  .bar span{position:absolute;inset:0 auto 0 0;background:var(--accent);transition:width .3s ease}

  main{flex:1;padding:20px 22px 24px}
  section[hidden]{display:none}

  /* ── Chips de categoría ────────────────────────────── */
  .chips{display:flex;gap:8px;flex-wrap:wrap}
  .chip{padding:9px 16px;border-radius:999px;border:1px solid #E0CDD0;background:none;font:400 11px var(--sans);letter-spacing:.12em;text-transform:uppercase;color:#8C7E80;cursor:pointer}
  .chip[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--paper)}

  /* ── Filas seleccionables (servicios, personas, pago) ─ */
  .list{display:flex;flex-direction:column;gap:10px;margin-top:18px}
  .row{width:100%;text-align:left;background:var(--card);border:1px solid var(--line);padding:16px 18px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;cursor:pointer;font:inherit;color:inherit;transition:border-color .15s}
  .row[aria-pressed="true"]{border-color:var(--accent)}
  .row .meta{font:300 11.5px/1.5 var(--sans);color:var(--muted);margin-top:4px}
  .dot{width:22px;height:22px;border-radius:50%;border:1px solid #DFCED1;color:#fff;font:400 12px/20px var(--sans);text-align:center;flex:none;margin-left:auto}
  .row[aria-pressed="true"] .dot{background:var(--accent);border-color:var(--accent)}
  .row .right{text-align:right;flex:none;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
  .avatar{width:54px;height:54px;border-radius:50%;background:#EEDCE0;flex:none;display:flex;align-items:center;justify-content:center;font:400 10px var(--sans);letter-spacing:.1em;color:var(--accent)}

  /* ── Calendario ────────────────────────────────────── */
  .days{display:flex;gap:8px}
  .day{flex:1;min-width:0;text-align:center;padding:12px 0;border:1px solid var(--line-2);background:var(--card);cursor:pointer;font:inherit;color:inherit}
  .day[aria-pressed="true"]{background:var(--ink);border-color:var(--ink)}
  .day .dw{font:400 8.5px/1 var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2)}
  .day .dn{font-family:var(--serif);font-size:20px;margin-top:5px}
  .day[aria-pressed="true"] .dw{color:#D9AEB9}
  .day[aria-pressed="true"] .dn{color:#fff}
  .day:disabled{background:var(--disabled-bg);border-color:transparent;color:var(--disabled-fg);cursor:default}
  .slots{margin-top:12px;display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
  .slot{padding:13px 0;border:1px solid var(--line-2);background:var(--card);font:400 12.5px var(--sans);color:var(--ink);cursor:pointer}
  .slot[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:#fff}
  .slot:disabled{background:var(--disabled-bg);border-color:transparent;color:var(--disabled-fg);text-decoration:line-through;cursor:default}

  /* ── Resumen y confirmación ────────────────────────── */
  .card{background:var(--card);border:1px solid var(--line);padding:20px}
  .li{display:flex;justify-content:space-between;align-items:baseline;padding:6px 0}
  .li .name{font-size:18px}
  .rule{margin-top:14px;padding-top:14px;border-top:1px solid #F2E7E7}
  .switchrow{margin-top:16px;background:#F5E9EA;padding:16px 18px;display:flex;justify-content:space-between;align-items:center;gap:12px;border:0;width:100%;cursor:pointer;font:300 12px/1.55 var(--sans);color:#5E5254;text-align:left}
  .switch{width:40px;height:22px;border-radius:999px;background:#DDCED0;position:relative;flex:none;transition:background .2s}
  .switch i{position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:50%;background:#fff;transition:left .2s}
  .switchrow[aria-pressed="true"] .switch{background:var(--accent)}
  .switchrow[aria-pressed="true"] .switch i{left:20px}
  .done{text-align:center;padding-top:26px}
  .tick{width:66px;height:66px;border-radius:50%;border:1px solid #D9AEB9;margin:0 auto;display:flex;align-items:center;justify-content:center;font:300 24px var(--sans);color:var(--accent)}

  /* ── Barra inferior ────────────────────────────────── */
  footer{position:sticky;bottom:0;background:var(--paper);border-top:1px solid var(--line);padding:14px 22px calc(14px + env(safe-area-inset-bottom))}
  .ftop{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px}
  .total{font-family:var(--serif);font-size:21px}
  .cta{width:100%;padding:16px;border:0;background:var(--ink);color:var(--paper);font:400 11.5px var(--sans);letter-spacing:.18em;text-transform:uppercase;cursor:pointer}
  .cta:disabled{background:#E4D6D8;color:#A79B9C;cursor:default}
  .ghost{width:100%;padding:14px;background:none;border:1px solid var(--ink);color:var(--ink);font:400 11.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;cursor:pointer}
  .link{width:100%;padding:14px;background:none;border:0;color:var(--accent);font:400 11.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;cursor:pointer}
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="hrow">
      <button class="back" id="back" aria-label="Volver">&#8592;</button>
      <div class="eyebrow" id="stepLabel">Paso 1 de 4</div>
      <div style="width:34px"></div>
    </div>
    <div class="h1" id="stepTitle" style="margin-top:12px">Elija sus servicios</div>
    <div class="bar"><span id="progress" style="width:25%"></span></div>
  </header>

  <main>
    <!-- 1. Catálogo -->
    <section id="step0">
      <div class="chips" id="chips"></div>
      <div class="list" id="services"></div>
    </section>

    <!-- 2. Especialista -->
    <section id="step1" hidden>
      <div class="list" id="specialists" style="margin-top:0"></div>
      <p class="hint">La disponibilidad se calcula con la agenda real de cada especialista, incluyendo almuerzos y días libres.</p>
    </section>

    <!-- 3. Fecha y hora -->
    <section id="step2" hidden>
      <div class="days" id="days"></div>
      <div class="eyebrow" style="margin-top:24px">Mañana</div>
      <div class="slots" id="amSlots"></div>
      <div class="eyebrow" style="margin-top:24px">Tarde</div>
      <div class="slots" id="pmSlots"></div>
      <p class="hint" id="slotNote"></p>
    </section>

    <!-- 4. Confirmación -->
    <section id="step3" hidden>
      <div class="card">
        <div class="eyebrow" style="color:var(--accent)">Resumen</div>
        <div id="sumLines" style="margin-top:10px"></div>
        <div class="rule" style="font:300 12px/1.7 var(--sans);color:#7A6C6E" id="sumWhen"></div>
      </div>
      <div class="eyebrow" style="margin-top:22px">Forma de pago</div>
      <div class="list" id="methods"></div>
      <button class="switchrow" id="reminder" aria-pressed="true">
        <span>Recordatorio por WhatsApp 24 h antes de la cita</span>
        <span class="switch"><i></i></span>
      </button>
      <p class="hint">Sin adelanto. El pago se realiza al finalizar el servicio. Puede cancelar o reprogramar hasta 12 horas antes.</p>
    </section>

    <!-- 5. Listo -->
    <section id="step4" hidden>
      <div class="done">
        <div class="tick">&#10003;</div>
        <div class="h1" style="font-size:29px;margin-top:22px">Su cita está confirmada</div>
        <p style="font:300 13px/1.7 var(--sans);color:#7A6C6E" id="doneWhen"></p>
        <div class="card" style="margin-top:26px;text-align:left">
          <div id="doneLines"></div>
          <div class="rule" style="display:flex;justify-content:space-between;align-items:baseline">
            <span class="eyebrow">Total a pagar</span>
            <span style="font-family:var(--serif);font-size:24px" id="doneTotal"></span>
          </div>
          <p class="hint" id="doneMethod"></p>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px">
          <button class="ghost" id="ics">Agregar al calendario</button>
          <button class="link" id="restart">Volver al inicio</button>
        </div>
      </div>
    </section>
  </main>

  <footer id="footer">
    <div class="ftop"><span class="hint" id="barNote"></span><span class="total" id="total"></span></div>
    <button class="cta" id="cta">Continuar</button>
  </footer>
</div>

<script>
/* ─────────────────────────────────────────────────────────
   Datos de demostración. En producción vienen de Supabase:
   services, specialists, work_schedules, time_off, appointments.
   ───────────────────────────────────────────────────────── */
const CATS = [
  { id:'unas', name:'Uñas' },
  { id:'pestanas', name:'Pestañas' },
  { id:'cabello', name:'Cabello' },
  { id:'maquillaje', name:'Maquillaje' },
];

const SERVICES = [
  { id:'s1',  cat:'unas',       name:'Manicure ruso spa + semipermanente', price:16000, min:90  },
  { id:'s2',  cat:'pestanas',   name:'Pestañas pelo a pelo',               price:15000, min:120 },
  { id:'s3',  cat:'pestanas',   name:'Clásicas · primera colocación',      price:15000, min:90  },
  { id:'s4',  cat:'pestanas',   name:'Naturales · primera colocación',     price:17000, min:105 },
  { id:'s5',  cat:'pestanas',   name:'Híbridas · primera colocación',      price:20000, min:120 },
  { id:'s6',  cat:'pestanas',   name:'Volumen · primera colocación',       price:24000, min:135 },
  { id:'s7',  cat:'pestanas',   name:'Mega volumen · primera colocación',  price:34000, min:150 },
  { id:'s8',  cat:'cabello',    name:'Tratamientos hidratantes',           price:15000, min:60  },
  { id:'s9',  cat:'cabello',    name:'Lavado, blower, plancha y corte',    price:20000, min:75  },
  { id:'s10', cat:'cabello',    name:'Botox capilar',                      price:30000, min:120 },
  { id:'s11', cat:'cabello',    name:'Nanoplastia',                        price:50000, min:180 },
  { id:'s12', cat:'cabello',    name:'Peinados',                           price:10000, min:45  },
  { id:'s13', cat:'maquillaje', name:'Maquillaje y peinado',               price:45000, min:120 },
];

const SPECIALISTS = [
  { id:'celine', name:'Celine Barrantes',      note:'Uñas, pestañas, cabello y maquillaje · Fundadora', initials:'CB' },
  { id:'any',    name:'Cualquiera disponible', note:'Le asignamos la especialista con el horario más cercano', initials:'—' },
];

const METHODS = [
  { id:'sinpe',    name:'SINPE Móvil',          note:'Transferencia el día de la cita', label:'Pago por SINPE Móvil al finalizar el servicio' },
  { id:'efectivo', name:'Efectivo en el salón', note:'Pago directo en recepción',       label:'Pago en efectivo en recepción' },
];

/* busy[] simula appointments ya reservados para esa fecha */
const DAYS = [
  { key:'d1', dow:'mar', num:25, busy:['9:00','10:30','15:00'] },
  { key:'d2', dow:'mié', num:26, busy:['11:00','13:00'] },
  { key:'d3', dow:'jue', num:27, busy:['9:00','9:45'] },
  { key:'d4', dow:'vie', num:28, busy:['16:30'] },
  { key:'d5', dow:'sáb', num:29, busy:['9:00','10:30','11:00','13:00','15:00'] },
  { key:'d6', dow:'dom', num:30, closed:true },
];
const DOW_FULL = { mar:'Martes', 'mié':'Miércoles', jue:'Jueves', vie:'Viernes', 'sáb':'Sábado', dom:'Domingo' };
const AM = ['9:00','9:45','10:30','11:00','11:45'];
const PM = ['13:00','13:45','15:00','15:45','16:30','17:15'];

const TITLES = ['Elija sus servicios','¿Con quién desea atenderse?','Fecha y hora','Confirme su reserva',''];
const CTAS   = ['Continuar','Elegir fecha','Revisar','Confirmar cita',''];

/* ── Estado ─────────────────────────────────────────────── */
const state = { step:0, cat:'unas', picked:['s1'], who:'celine', day:'d3', time:null, method:'sinpe', reminder:true };

/* ── Utilidades ─────────────────────────────────────────── */
const crc = n => '₡' + String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.');
const dur = m => m < 60 ? m + ' min' : Math.floor(m/60) + ' h' + (m%60 ? ' ' + (m%60) + ' min' : '');
const hr  = t => { if(!t) return '—'; const [h,m] = t.split(':'); const H = +h; return (H>12?H-12:H) + ':' + m + (H>=12?' p. m.':' a. m.'); };
const el  = id => document.getElementById(id);
const chosen = () => SERVICES.filter(s => state.picked.includes(s.id));
const total = () => chosen().reduce((a,s) => a + s.price, 0);
const minutes = () => chosen().reduce((a,s) => a + s.min, 0);
const today = () => DAYS.find(d => d.key === state.day);

function tag(html){ const t = document.createElement('template'); t.innerHTML = html.trim(); return t.content.firstElementChild; }

/* ── Render ─────────────────────────────────────────────── */
function render(){
  const s = state.step;

  el('stepLabel').textContent = s < 4 ? 'Paso ' + (s+1) + ' de 4' : 'Reserva confirmada';
  el('stepTitle').textContent = TITLES[s];
  el('stepTitle').hidden = s === 4;
  el('progress').style.width = [25,50,75,100,100][s] + '%';
  el('back').style.visibility = s === 0 || s === 4 ? 'hidden' : 'visible';
  for (let i = 0; i < 5; i++) el('step' + i).hidden = i !== s;

  /* 1. Catálogo */
  el('chips').replaceChildren(...CATS.map(c => {
    const b = tag(`<button class="chip" aria-pressed="${state.cat===c.id}">${c.name}</button>`);
    b.onclick = () => { state.cat = c.id; render(); };
    return b;
  }));
  el('services').replaceChildren(...SERVICES.filter(x => x.cat === state.cat).map(x => {
    const on = state.picked.includes(x.id);
    const r = tag(`<button class="row" aria-pressed="${on}">
      <span><span class="name">${x.name}</span><span class="meta" style="display:block">${dur(x.min)} · con Celine</span></span>
      <span class="right"><span class="price">${crc(x.price)}</span><span class="dot">${on?'&#10003;':''}</span></span>
    </button>`);
    r.onclick = () => {
      state.picked = on ? state.picked.filter(i => i !== x.id) : state.picked.concat(x.id);
      state.time = null;
      render();
    };
    return r;
  }));

  /* 2. Especialista */
  el('specialists').replaceChildren(...SPECIALISTS.map(p => {
    const on = state.who === p.id;
    const r = tag(`<button class="row" aria-pressed="${on}" style="align-items:center">
      <span class="avatar">${p.initials}</span>
      <span style="flex:1"><span class="name" style="font-size:20px">${p.name}</span><span class="meta" style="display:block">${p.note}</span></span>
      <span class="dot">${on?'&#10003;':''}</span>
    </button>`);
    r.onclick = () => { state.who = p.id; state.time = null; render(); };
    return r;
  }));

  /* 3. Fecha y hora */
  el('days').replaceChildren(...DAYS.map(d => {
    const b = tag(`<button class="day" aria-pressed="${state.day===d.key}" ${d.closed?'disabled':''}>
      <span class="dw">${d.dow}</span><span class="dn" style="display:block">${d.num}</span>
    </button>`);
    b.onclick = () => { state.day = d.key; state.time = null; render(); };
    return b;
  }));
  const day = today();
  const slotBtns = list => list.map(t => {
    const open = !day.closed && !(day.busy || []).includes(t);
    const b = tag(`<button class="slot" aria-pressed="${state.time===t}" ${open?'':'disabled'}>${hr(t)}</button>`);
    b.onclick = () => { state.time = t; render(); };
    return b;
  });
  el('amSlots').replaceChildren(...slotBtns(AM));
  el('pmSlots').replaceChildren(...slotBtns(PM));
  el('slotNote').textContent = 'Los horarios tachados ya están ocupados o no alcanzan para ' + dur(minutes()) + ' de servicio.';

  /* 4. Confirmación */
  const lines = () => chosen().map(x => tag(`<div class="li"><span class="name">${x.name}</span><span class="price">${crc(x.price)}</span></div>`));
  el('sumLines').replaceChildren(...lines());
  const when = (DOW_FULL[day.dow] || '') + ' ' + day.num + ' de agosto · ' + hr(state.time);
  const who = SPECIALISTS.find(p => p.id === state.who).name;
  el('sumWhen').innerHTML = when + '<br>' + who + ' · ' + dur(minutes());
  el('methods').replaceChildren(...METHODS.map(m => {
    const on = state.method === m.id;
    const r = tag(`<button class="row" aria-pressed="${on}" style="align-items:center">
      <span><span style="font:400 13.5px var(--sans)">${m.name}</span><span class="meta" style="display:block">${m.note}</span></span>
      <span class="dot">${on?'&#10003;':''}</span>
    </button>`);
    r.onclick = () => { state.method = m.id; render(); };
    return r;
  }));
  el('reminder').setAttribute('aria-pressed', state.reminder);

  /* 5. Listo */
  el('doneWhen').innerHTML = when + '<br>' + who;
  el('doneLines').replaceChildren(...lines());
  el('doneTotal').textContent = crc(total());
  el('doneMethod').textContent = METHODS.find(m => m.id === state.method).label;

  /* Barra inferior */
  el('footer').hidden = s === 4;
  const n = chosen().length;
  el('barNote').textContent = n ? n + (n === 1 ? ' servicio · ' : ' servicios · ') + dur(minutes()) : 'Ningún servicio seleccionado';
  el('total').textContent = crc(total());
  el('cta').textContent = CTAS[s];
  el('cta').disabled = [n > 0, true, !!state.time, true, true][s] === false;
}

/* ── Navegación ─────────────────────────────────────────── */
const go = n => { state.step = Math.max(0, Math.min(4, n)); window.scrollTo(0,0); render(); };
el('cta').onclick = () => go(state.step + 1);
el('back').onclick = () => go(state.step - 1);
el('restart').onclick = () => { Object.assign(state, { step:0, picked:['s1'], time:null }); render(); };
el('reminder').onclick = () => { state.reminder = !state.reminder; render(); };
el('ics').onclick = () => alert('Aquí se genera el archivo .ics o se llama al calendario nativo.');

render();
</script>
</body>
</html>
